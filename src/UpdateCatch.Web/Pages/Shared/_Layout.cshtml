<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UpdateCatch</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
        }
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand-gradient {
            font-weight: 800;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }
        .card-custom {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .card-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
        }
        .badge-target {
            font-weight: 600;
            padding: 0.35em 0.7em;
            border-radius: 6px;
        }
        .badge-vscode { background-color: #007acc; color: white; }
        .badge-python { background-color: #3776ab; color: white; }
        .badge-gemini { background-color: #4285f4; color: white; }
        .badge-claude { background-color: #d97706; color: white; }
        .badge-openai { background-color: #10a37f; color: white; }
        .badge-dotnet { background-color: #512bd4; color: white; }
        .badge-macos { background-color: #1d1d1f; color: white; }
        .badge-windows { background-color: #0078d4; color: white; }
        .badge-default { background-color: #64748b; color: white; }
        
        .tag-pill {
            font-size: 0.75rem;
            background-color: #e2e8f0;
            color: #475569;
            border-radius: 9999px;
            padding: 0.2rem 0.6rem;
            margin-right: 0.3rem;
            display: inline-block;
        }
        .tag-ai { background-color: #f3e8ff; color: #7e22ce; }
        .tag-security { background-color: #fee2e2; color: #b91c1c; }
        .tag-breaking { background-color: #ffedd5; color: #c2410c; }
        .tag-perf { background-color: #dcfce7; color: #15803d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand navbar-brand-gradient d-flex align-items-center gap-2" asp-page="/Index">
                <i class="bi bi-radar text-primary fs-3"></i>
                <span>UpdateCatch</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3 fw-semibold" asp-page="/Index">
                            <i class="bi bi-clock-history me-1"></i> 타임라인 피드
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 fw-semibold text-primary" asp-page="/Search">
                            <i class="bi bi-stars me-1"></i> AI 시맨틱 검색
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 fw-semibold" asp-page="/Targets">
                            <i class="bi bi-collection me-1"></i> 모니터링 타겟
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-secondary border px-3 py-2">
                        <i class="bi bi-git me-1"></i> GitHub Actions Automated
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            UpdateCatch &copy; @DateTime.UtcNow.Year - .NET 10 Razor & Vector DB Powered Software Release Tracker
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
