@page
@model IndexModel
@{
    ViewData["Title"] = "최신 업데이트 피드";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i>최신 업데이트 타임라인
        </h2>
        <p class="text-muted mb-0">주요 소프트웨어 및 Frontier AI 모델의 릴리즈 소식을 자동으로 수집하여 요약합니다.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a asp-page="/Search" class="btn btn-outline-primary fw-semibold me-2">
            <i class="bi bi-stars me-1"></i> AI 시맨틱 검색
        </a>
        <a asp-page="/Targets" class="btn btn-light border fw-semibold">
            <i class="bi bi-gear me-1"></i> 타겟 관리
        </a>
    </div>
</div>

<!-- 필터 칩 -->
<div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
    <a asp-page="/Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedTarget) ? "btn-dark fw-bold" : "btn-light border")">전체 보기</a>
    <a asp-page="/Index" asp-route-target="vscode" class="btn btn-sm @(Model.SelectedTarget == "vscode" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-code-square me-1"></i> VS Code
    </a>
    <a asp-page="/Index" asp-route-target="python" class="btn btn-sm @(Model.SelectedTarget == "python" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-filetype-py me-1"></i> Python
    </a>
    <a asp-page="/Index" asp-route-target="gemini" class="btn btn-sm @(Model.SelectedTarget == "gemini" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-google me-1"></i> Google Gemini
    </a>
    <a asp-page="/Index" asp-route-target="claude" class="btn btn-sm @(Model.SelectedTarget == "claude" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-robot me-1"></i> Anthropic Claude
    </a>
    <a asp-page="/Index" asp-route-target="openai" class="btn btn-sm @(Model.SelectedTarget == "openai" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-chat-left-dots me-1"></i> OpenAI GPT
    </a>
    <a asp-page="/Index" asp-route-target="dotnet" class="btn btn-sm @(Model.SelectedTarget == "dotnet" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-microsoft me-1"></i> .NET
    </a>
    <a asp-page="/Index" asp-route-target="macos" class="btn btn-sm @(Model.SelectedTarget == "macos" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-apple me-1"></i> macOS
    </a>
    <a asp-page="/Index" asp-route-target="windows" class="btn btn-sm @(Model.SelectedTarget == "windows" ? "btn-primary fw-bold" : "btn-light border")">
        <i class="bi bi-windows me-1"></i> Windows
    </a>
</div>

@if (Model.Releases.Count == 0)
{
    <div class="card p-5 text-center bg-white border-0 shadow-sm rounded-4">
        <div class="mb-3">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        </div>
        <h5 class="fw-bold">수집된 릴리즈 노트가 없습니다</h5>
        <p class="text-muted">GitHub Actions가 실행되거나 수집기를 실행하여 최신 업데이트 데이터를 수집해 보세요.</p>
        <div class="mt-2">
            <code>dotnet run --project src/UpdateCatch.Collector</code>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var rel in Model.Releases)
        {
            <div class="col-lg-6">
                <div class="card card-custom h-100 bg-white p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge badge-target @Model.GetBadgeClass(rel.TargetId)">
                            @rel.TargetName
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-light border text-primary fw-semibold px-2 py-0" style="font-size: 0.75rem;" onclick="toggleCardTranslation('@rel.Id')" id="btn-trans-@rel.Id">
                                <i class="bi bi-translate me-1"></i>한글 번역
                            </button>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@rel.PublishedAt.ToString("yyyy-MM-dd")
                            </small>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2 mt-1" id="title-@rel.Id">
                        @rel.Title
                    </h5>

                    <!-- 태그 목록 -->
                    <div class="mb-3">
                        @foreach (var tag in rel.Tags)
                        {
                            <span class="tag-pill @Model.GetTagClass(tag)">#@tag</span>
                        }
                    </div>

                    <!-- AI 핵심 3줄 요약 (Key Takeaways) -->
                    <div id="takeaways-@rel.Id">
                    @if (rel.KeyTakeaways.Count > 0)
                    {
                        <div class="p-3 bg-light rounded-3 mb-3 border-start border-4 border-primary">
                            <div class="fw-semibold small text-primary mb-1">
                                <i class="bi bi-lightning-charge-fill me-1"></i>핵심 하이라이트 요약
                            </div>
                            <ul class="mb-0 ps-3 small text-secondary">
                                @foreach (var takeaway in rel.KeyTakeaways)
                                {
                                    <li class="mb-1">@takeaway</li>
                                }
                            </ul>
                        </div>
                    }
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary-subtle text-secondary">버전: @rel.Version</span>
                        @if (!string.IsNullOrEmpty(rel.HtmlUrl))
                        {
                            <a href="@rel.HtmlUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark">
                                공식 원문 보기 <i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    const translationCache = new Map();

    async function fetchGoogleTranslate(text) {
        if (!text || text.trim().length === 0) return text;
        if (translationCache.has(text)) return translationCache.get(text);
        try {
            const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=ko&dt=t&q=${encodeURIComponent(text.slice(0, 1500))}`;
            const res = await fetch(url);
            const data = await res.json();
            if (data && data[0]) {
                const translated = data[0].map(chunk => chunk[0]).join('');
                translationCache.set(text, translated);
                return translated;
            }
        } catch (e) {
            console.error('Translation failed:', e);
        }
        return text;
    }

    async function toggleCardTranslation(relId) {
        const titleEl = document.getElementById(`title-${relId}`);
        const takeawaysEl = document.getElementById(`takeaways-${relId}`);
        const btnEl = document.getElementById(`btn-trans-${relId}`);
        const isKo = btnEl.getAttribute('data-translated') === 'true';

        if (isKo) {
            titleEl.innerText = titleEl.getAttribute('data-orig-title');
            takeawaysEl.innerHTML = takeawaysEl.getAttribute('data-orig-html');
            btnEl.innerHTML = '<i class="bi bi-translate me-1"></i>한글 번역';
            btnEl.setAttribute('data-translated', 'false');
            btnEl.className = 'btn btn-sm btn-light border text-primary fw-semibold px-2 py-0';
        } else {
            if (!titleEl.hasAttribute('data-orig-title')) {
                titleEl.setAttribute('data-orig-title', titleEl.innerText);
                takeawaysEl.setAttribute('data-orig-html', takeawaysEl.innerHTML);
            }
            btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>번역 중...';

            const koTitle = await fetchGoogleTranslate(titleEl.innerText);
            titleEl.innerText = koTitle;

            const items = takeawaysEl.querySelectorAll('li');
            for (const li of items) {
                li.innerText = await fetchGoogleTranslate(li.innerText);
            }

            btnEl.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>원문 보기';
            btnEl.setAttribute('data-translated', 'true');
            btnEl.className = 'btn btn-sm btn-primary text-white fw-semibold px-2 py-0';
        }
    }
</script>
}
